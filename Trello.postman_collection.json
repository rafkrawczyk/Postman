    {
      "name": "Create a board",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "id": "9cb0073e-d624-4ec8-a1d3-0bece11c8924",
            "exec": [
              "let boardNumber = pm.collectionVariables.get(\"boardNumber\");",
              "if (isNaN(boardNumber) || (boardNumber == 0)) {",
              "    boardNumber = 0;",
              "}",
              "boardNumber++;",
              "pm.collectionVariables.set(\"boardNumber\", boardNumber);",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "id": "94d87632-b712-492f-8570-200408799b42",
            "exec": [
              "pm.test(\"Status code is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let jsonData;",
              "",
              "pm.test(\"Board created successfully\", () => {",
              "    jsonData = pm.response.json();",
              "    pm.expect(jsonData.name).to.eql(\"Learning Postman \" + pm.collectionVariables.get(\"boardNumber\"));",
              "    pm.collectionVariables.set(\"boardIdToDelete\", jsonData.id);",
              "});",
              "",
              "pm.test(\"Board is open\", () => {",
              "    jsonData = pm.response.json();",
              "    pm.expect(jsonData.closed).to.be.false;",
              "});",
              "",
              "pm.test(\"Board is private\", () => {",
              "    jsonData = pm.response.json();",
              "    pm.expect(jsonData.prefs.permissionLevel).to.eql(\"private\");",
              "});",
              "",
              "pm.test(\"Calendar view is disabled\", () => {",
              "    jsonData = pm.response.json();    ",
              "    pm.expect(jsonData.prefs.switcherViews.find(view => view.viewType === \"Calendar\")).to.be.an(\"object\");",
              "    pm.expect(jsonData.prefs.switcherViews.find(view => view.viewType === \"Calendar\").enabled).to.be.false;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
